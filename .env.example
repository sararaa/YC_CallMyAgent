# Gemini
GEMINI_API_KEY=

# Telephony (AgentPhone)
AGENTPHONE_API_KEY=
AGENTPHONE_NUMBER=
AGENTPHONE_WEBHOOK_SECRET=

# Memory tiers (leave blank to use stubs)
SUPERMEMORY_API_KEY=
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# Tunable: re-load Moss session index after each add_docs to force refresh
MOSS_FORCE_REFRESH_ON_ADD=true

# App
PORT=8000
DASHBOARD_ORIGIN=http://localhost:3000
DB_PATH=backend/db/volt.db
